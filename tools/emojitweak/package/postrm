#!/bin/sh
set -e

PKG="@PACKAGE@"
PKGDIR="@PKGDIR@"
SYSDIR="@SYSDIR@"
FONT_1X="@FONT_1X@"
FONT_2X="@FONT_2X@"

say() { echo "$PKG: $*"; }
warn() { echo "$PKG: $*" >&2; }

free_kb() {
    _line=$(df -kP "$1" 2>/dev/null | sed -n 2p) || return 1
    [ -n "$_line" ] || return 1
    set -- $_line
    case "$4" in
        ''|*[!0-9]*) return 1 ;;
    esac
    echo "$4"
}

file_bytes() {
    [ -f "$1" ] || { echo 0; return 0; }
    set -- $(ls -l "$1")
    case "$5" in
        ''|*[!0-9]*) echo 0 ;;
        *) echo "$5" ;;
    esac
}

restore_one() {
    name="$1"
    backup="$PKGDIR/$name.stock"
    sysfont="$SYSDIR/$name"
    tmp="$sysfont.emojitweak-old"

    [ -f "$sysfont" ] || return 0

    if [ ! -f "$backup" ]; then
        {
            echo ""
            echo "$PKG: no stock font backup found at $backup."
            echo ""
            echo "  The font now at $sysfont has been left in place on purpose:"
            echo "  deleting it would leave the device with no colour emoji at all."
            echo ""
            echo "  To get Apple's original font back, copy $name out of an"
            echo "  iOS 6.1.3 IPSW (or another backup of this device) to:"
            echo "      $sysfont"
            echo "  then respring."
            echo ""
        } >&2
        return 0
    fi

    if cmp -s "$sysfont" "$backup"; then
        say "the stock font is already in place at $sysfont"
        return 0
    fi

    want=$(file_bytes "$backup")
    if [ "$want" -lt 1024 ]; then
        warn "backup $backup looks truncated ($want bytes); leaving the current font in place."
        return 0
    fi

    if [ ! -w "$SYSDIR" ]; then
        warn "$SYSDIR is not writable; the stock font was NOT restored."
        warn "remount / read-write and copy $backup to $sysfont by hand."
        return 0
    fi

    need_kb=$(( want / 1024 + 1024 ))
    have=$(free_kb "$SYSDIR" || echo "")
    rm -f "$tmp"

    if [ -n "$have" ] && [ "$have" -lt "$need_kb" ]; then
        say "little space on $SYSDIR; removing the replacement font before restoring $name"
        rm -f "$sysfont"
        if ! cp "$backup" "$sysfont"; then
            warn "restoring $sysfont from $backup FAILED and there is now no emoji font."
            warn "free up space and run: cp $backup $sysfont"
            return 0
        fi
    else
        if ! cp "$backup" "$tmp"; then
            rm -f "$tmp"
            warn "restoring the stock font failed; $sysfont still holds this package's font."
            warn "run by hand: cp $backup $sysfont"
            return 0
        fi
        mv "$tmp" "$sysfont"
    fi

    chown root:wheel "$sysfont" 2>/dev/null || true
    chmod 644 "$sysfont"
    say "restored the stock font to $sysfont"
    restored=$(( restored + 1 ))
}

restore() {
    restored=0
    for name in "$FONT_1X" "$FONT_2X"; do
        restore_one "$name"
    done
    [ "$restored" -gt 0 ] || return 0

    say "the backups are kept in $PKGDIR; purging this package deletes them"

    if [ -n "${EMOJITWEAK_NO_RESPRING:-}" ]; then
        say "EMOJITWEAK_NO_RESPRING is set; respring by hand."
    elif [ -x "$PKGDIR/respring" ]; then
        "$PKGDIR/respring" 4 >/dev/null 2>&1 &
    else
        ( sleep 4; killall -9 SpringBoard ) >/dev/null 2>&1 &
    fi
}

case "$1" in
remove)
    restore
    ;;
purge)
    restore
    for name in "$FONT_1X" "$FONT_2X"; do
        rm -f "$PKGDIR/$name.stock" "$PKGDIR/$name.stock.part"
    done
    rm -f "$PKGDIR/respring"
    rmdir "$PKGDIR" 2>/dev/null || true
    ;;
upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
esac

exit 0
