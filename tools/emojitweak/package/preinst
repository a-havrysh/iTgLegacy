#!/bin/sh
set -e

PKG="@PACKAGE@"
SYSFONT="@SYSFONT@"
SYSDIR="@SYSDIR@"
FONT_KB=@FONT_KB@
MARGIN_KB=@MARGIN_KB@

say() { echo "$PKG: $*"; }
die() { echo "$PKG: $*" >&2; exit 1; }

free_kb() {
    _line=$(df -kP "$1" 2>/dev/null | sed -n 2p) || return 1
    [ -n "$_line" ] || return 1
    set -- $_line
    case "$4" in
        ''|*[!0-9]*) return 1 ;;
    esac
    echo "$4"
}

file_kb() {
    [ -f "$1" ] || { echo 0; return 0; }
    set -- $(ls -l "$1")
    case "$5" in
        ''|*[!0-9]*) echo 0 ;;
        *) echo $(( $5 / 1024 )) ;;
    esac
}

action="$1"

case "$action" in
install|upgrade)
    [ -d "$SYSDIR" ] || die "$SYSDIR does not exist; this does not look like an iOS 6 system font layout."
    [ -w "$SYSDIR" ] || die "$SYSDIR is not writable. Remount the system partition read-write and install again."

    have=$(free_kb "$SYSDIR" || true)
    if [ -z "$have" ]; then
        say "warning: cannot read free space on $SYSDIR; continuing without the space check."
        exit 0
    fi

    need=$(( FONT_KB + MARGIN_KB ))
    if [ "$have" -ge "$need" ]; then
        exit 0
    fi

    cur_kb=$(file_kb "$SYSFONT")
    short=$(( (need - have + 1023) / 1024 ))
    {
        echo ""
        echo "$PKG: not enough free space on the system partition."
        echo ""
        echo "  mount point : $SYSDIR"
        echo "  free        : $(( have / 1024 )) MB"
        echo "  needed      : $(( need / 1024 )) MB  ($(( FONT_KB / 1024 )) MB font + $(( MARGIN_KB / 1024 )) MB working room)"
        echo ""
        echo "  The new font is written next to the current one and only then swapped"
        echo "  in, so the $(( cur_kb / 1024 )) MB the present font occupies does not count as free space."
        echo ""
        echo "  Free at least $short MB on / and install again."
        echo "  Nothing has been changed."
        echo ""
    } >&2
    exit 1
    ;;
abort-upgrade)
    ;;
esac

exit 0
